{
    "name": "thomsontochi/laravel-agent-loops",
    "description": "A Laravel agent harness with swappable loops. Pick how your AI agent thinks, switch with one line, compare which works best.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "ai", "agents", "agent-harness", "llm"],
    "authors": [
        {
            "name": "Austin Opia",
            "homepage": "https://austinopia.aidevelopia.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/ai": "^1.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Developia\\AgentLoops\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Developia\\AgentLoops\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "pint",
        "test": [
            "pint --test",
            "pest"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "laravel/pint": "^1.32"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
